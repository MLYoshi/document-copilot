# --- Supabase ---
# Project Settings > API. Use the Supabase Postgres connection pooler for the app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side only. Required for corpus ingestion; never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIMENSIONS=1024
CHAT_MODEL=minimax/minimax-m3:free
RETRIEVAL_TOP_K=8

# --- Server ---
ALLOWED_ORIGINS=http://localhost:5173
CORPUS_OWNER_EMAIL=corpus@system.local
