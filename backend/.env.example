# --- Database (SQLAlchemy + Alembic) ---

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/document_copilot

# --- JWT Auth ---

# Generate with: openssl rand -hex 32 (minimum 32 bytes, enforced at startup)
JWT_SECRET_KEY=change-me-change-me-change-me-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OpenAI (needed once the LLM / embedding layer is wired up) ---

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
